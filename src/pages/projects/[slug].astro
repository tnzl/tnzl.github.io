---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description} narrow>
  <a class="back-link" href="/projects/">← Projects</a>
  <header class="entry-header">
    <h1>{project.data.title}</h1>
    <p class="muted">{project.data.description}</p>
    {
      project.data.tags.length > 0 && (
        <div class="tag-row">
          {project.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
    {
      project.data.github && (
        <p style="margin-top: 1rem;">
          <a href={project.data.github} target="_blank" rel="noopener noreferrer">
            View on GitHub →
          </a>
        </p>
      )
    }
  </header>
  <article class="prose">
    <Content />
  </article>
</BaseLayout>
