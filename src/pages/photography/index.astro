---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { photos } from '../../data/site';
---

<BaseLayout title="Photography" description="Photography by Tanzeel Ur Rahman.">
  <h1 class="page-title">Photography</h1>
  <p class="page-lead">A few frames.</p>

  <div class="photo-grid">
    {
      photos.map((photo) => (
        <figure class="photo-item">
          <img src={photo.src} alt={photo.alt} loading="lazy" width="800" height="1000" />
          <figcaption>{photo.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</BaseLayout>
