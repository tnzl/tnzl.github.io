---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = (await getCollection('notes'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Notes" description="Short notes by Tanzeel Ur Rahman.">
  <h1 class="page-title">Notes</h1>
  <p class="page-lead">Short evergreen snippets and cheat sheets.</p>

  <ul class="content-list">
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}/`}>
            <p class="item-meta">{formatDate(note.data.pubDate)}</p>
            <h2 class="item-title">{note.data.title}</h2>
            <p class="item-desc">{note.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="demo-note">Demo notes — replace the Markdown in <code>src/content/notes/</code> anytime.</p>
</BaseLayout>
